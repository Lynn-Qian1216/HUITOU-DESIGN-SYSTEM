{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/chat/**",
              "components/core/**",
              "components/data/**",
              "components/decision/**",
              "components/feedback/**",
              "components/forms/**",
              "components/navigation/**",
              "components/overlay/**",
              "doc-page.js",
              "ui_kits/console/**",
              "ui_kits/marketing/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Geist|Geist Mono|Noto Sans SC|Noto Serif SC))/i]",
        "message": "Font not provided by the design system. Available: Geist, Geist Mono, Noto Sans SC, Noto Serif SC."
      },
      {
        "selector": "JSXOpeningElement[name.name='AgentInquiryQuestion'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|options|key|ref|className|style|children)$/]",
        "message": "<AgentInquiryQuestion> doesn't accept that prop. Declared props: key, label, options."
      },
      {
        "selector": "JSXOpeningElement[name.name='AgentLoading'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|phases|phaseMs|skeleton|catWidth|src|style|key|ref|className|style|children)$/]",
        "message": "<AgentLoading> doesn't accept that prop. Declared props: label, phases, phaseMs, skeleton, catWidth, src, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AgentTimeline'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|style|key|ref|className|style|children)$/]",
        "message": "<AgentTimeline> doesn't accept that prop. Declared props: items, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|title|action|onDismiss|children|style|key|ref|className|style|children)$/]",
        "message": "<Alert> doesn't accept that prop. Declared props: tone, title, action, onDismiss, children, style."
      },
